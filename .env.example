# Copy to .env and fill in. Never commit .env.

# --- app ---
ENVIRONMENT=local
# Origins allowed to call the API from a browser (the dashboard is deployed
# separately, so this is required for it to work at all).
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:3200"]
DEBUG=true
LOG_LEVEL=INFO

# --- datastores ---
DATABASE_URL=postgresql+asyncpg://realtylead:realtylead@localhost:5432/realtylead
REDIS_URL=redis://localhost:6379/0
DB_ECHO=false

# Host ports docker-compose publishes on. Change these (and DATABASE_URL/REDIS_URL
# to match) if you already run Postgres or Redis locally on the defaults.
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- reliability (M8) ---
# Inbound messages are queued to Redis and answered by the inbound worker. Set
# this false to answer them inside the API process instead — simpler for a
# single-process local run, but a crash before the reply loses that turn.
INBOUND_QUEUE_ENABLED=true
# How long an unanswered turn waits before another worker retries it. Doubles as
# the retry backoff, so keep it comfortably above a slow model turn.
INBOUND_RETRY_AFTER_SECONDS=120
INBOUND_MAX_ATTEMPTS=4

# --- rate limits (M8) ---
# Model calls one lead can trigger per window. Their messages are still recorded
# past this; they just stop costing an Anthropic call until the window rolls.
INBOUND_MESSAGES_PER_LEAD=20
INBOUND_WINDOW_SECONDS=300
# Template nudges one agent can send per window — bounds a bulk import turning
# into a flood.
FOLLOW_UPS_PER_AGENT=60
FOLLOW_UP_WINDOW_SECONDS=3600
# Authentication attempts per email and per client address.
LOGIN_ATTEMPTS_PER_WINDOW=10
LOGIN_WINDOW_SECONDS=900

# --- Anthropic (M2) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Thinking depth / token spend: low | medium | high | xhigh | max.
# "low" keeps WhatsApp replies fast; raise it if qualification quality suffers.
ANTHROPIC_EFFORT=low
ANTHROPIC_MAX_TOKENS=1024
MAX_TOOL_ITERATIONS=6

# --- conversation defaults (per-agent settings override these) ---
DEFAULT_TIMEZONE=Asia/Kolkata
QUIET_HOURS_START=21
QUIET_HOURS_END=9
MAX_FOLLOW_UPS=6
ESCALATION_BUDGET_THRESHOLD=20000000

# --- outbound HTTP ---
HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=3

# --- WhatsApp Business Cloud API (M3) ---
# System user token from Meta Business, with whatsapp_business_messaging scope.
WHATSAPP_ACCESS_TOKEN=
# Any string you choose; Meta echoes it back during webhook verification.
WHATSAPP_VERIFY_TOKEN=
# App secret from the Meta app dashboard — used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0

# --- Google Calendar (M4) ---
# OAuth client (type "Web application") from Google Cloud Console, with the
# redirect URI below registered on it and the Calendar API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Signs the OAuth `state` parameter. Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=
